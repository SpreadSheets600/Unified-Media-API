# Unified API environment configuration.
# Copy to .env and adjust as needed (or export these variables).

# 4KHDHub base URL override (default: https://4khdhub.one/)
# MOVIEBOX_FOURKHDHUB_URL=https://4khdhub.one/

# Cache directory (default: system temp dir)
# UNIFIED_API_CACHE_DIR=/var/cache/unified-api
